{% extends 'base.html.twig' %}

{% block title %}Nouvelle image{% endblock %}

{% block body %}
<h1>{{ 'pin.new.title'|trans }}</h1>

{{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.imageFile) }}
    {# pulier #}
    <button type="submit">{{'pin.form.submit_new'|trans}}</button>
{{ form_end(form) }}
{% endblock %}