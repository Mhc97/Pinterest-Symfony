{% extends 'base.html.twig' %}

{% block title %}Connexion!{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}

        <h1>{{ 'auth.login.title'|trans }}</h1>
       <label for="username">{{ 'auth.login.email'|trans }}</label>
<input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>

<label for="password">{{ 'auth.login.password'|trans }}</label>
<input type="password" name="_password" id="password" autocomplete="current-password" required>

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button class="btn btn-lg btn-primary" type="submit">
        {# se connecter #}
            {{ 'auth.login.submit'|trans }}
        </button>
    </form>
{% endblock %}
