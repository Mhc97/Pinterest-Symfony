<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Pinterest{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
    <nav>
        <a href="{{ path('app_pin_index') }}" class="brand">
            <span class="mark">P</span>interest
        </a>

        <div class="nav-links">
            {% if app.user %}
                <a href="{{ path('app_pin_new') }}" class="cta">+ {{ 'nav.add_pin'|trans }}</a>
                <span class="user-chip">{{ app.user.userIdentifier }}</span>
                <a href="{{ path('app_logout') }}">{{ 'nav.logout'|trans }}</a>
            {% else %}
                <a href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                <a href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
            {% endif %}

            <div class="lang-switch">
                <a href="{{ path('app_locale_switch', {locale: 'fr'}) }}" class="{{ app.request.locale == 'fr' ? 'active' : '' }}">FR</a>
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" class="{{ app.request.locale == 'en' ? 'active' : '' }}">EN</a>
            </div>
        </div>
    </nav>

    {% for message in app.flashes('success') %}
        <div class="flash-success">{{ message }}</div>
    {% endfor %}

    {% block body %}{% endblock %}
</body>
</html>